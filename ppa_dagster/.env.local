# ppa_dagster — local env template.
# Copy to .env (gitignored) and fill in real values:
#   cp .env.local .env
# Do NOT commit real secrets. This file intentionally holds placeholders only.

# --- Source Postgres (Supabase), read by sling_ingest/defs.yaml + schema_drift ---
DBT_PROD_HOST=
DB_SLING_USER=
DB_SLING_PASSWORD=

# --- Dev DuckDB file (absolute path), written by Sling, read by dbt dev target ---
DUCKDB_DEV_DATABASE=

# --- Telegram run alerts (optional; sensors only error if they fire) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
