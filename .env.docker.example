# Template for the Windows/docker host. Copy to `.env.docker` and fill in:
#   cp .env.docker.example .env.docker
# `.env.docker` is gitignored — real values never get committed.
# (DuckDB paths and DBT_TARGET are pinned in docker-compose.yml, not here.)



# Source Postgres (read by Sling in defs/sling_ingest/defs.yaml
# and the schema-drift check). Names are historical — DB_SLING_USER /
# DB_SLING_PASSWORD *are* the Postgres credentials; nothing reads
# DBT_PROD_USER / DBT_PROD_PASSWORD, so they were removed.
# ALL-CAPS: env var names are case-sensitive, lowercase will NOT be picked up.
DBT_PROD_HOST=
DB_SLING_USER=
DB_SLING_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=